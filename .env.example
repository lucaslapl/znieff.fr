APP_NAME="Portail ZNIEFF"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# En production : APP_URL=https://znieff.fr — sitemap, canonicals et liens
# absolus (en console artisan y compris) dérivent de cette racine.
APP_URL=http://localhost:8010

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# --- PostgreSQL + PostGIS (UNIQUEMENT en local : conteneur Docker, port 5433) ---
# Tous les calculs spatiaux (intersections, surfaces) se font ici, lors de
# l'import annuel. La production (MySQL mutualisé PulseHéberg, sans PostGIS)
# reçoit le SQL portable de `portail:export-sql` et des GeoJSON précalculés :
# aucune géométrie n'est jamais stockée ni calculée en production.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=znieff
DB_USERNAME=znieff
DB_PASSWORD=znieff

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# --- Inertia SSR (rendu serveur pour le SEO) ---
# Local : false (les pages sont rendues côté client, c'est normal).
# Production : true + watchdog (cron) qui relance le serveur SSR ; utiliser un
# port DÉDIÉ (le défaut 13714 est partagé par toutes les apps Inertia du
# serveur — deux vhosts sur ce port se renvoient leurs rendus).
INERTIA_SSR_ENABLED=false
INERTIA_SSR_URL=http://127.0.0.1:13914
# Binaire Node du watchdog (chemin absolu recommandé, ex. Plesk :
# /opt/plesk/node/24/bin/node).
SSR_NODE_BIN=node

# --- Données INPN (import local uniquement, jamais dans git) ---
# En Docker, le répertoire est monté en lecture seule dans /data/inpn-data
# (voir docker-compose.yml). Hors Docker : chemin absolu du dossier
# data/inpn-data de l'Observatoire des ABC.
PORTAIL_INPN_DIR=/data/inpn-data
PORTAIL_ADMIN_EXPRESS_DIR=${PORTAIL_INPN_DIR}/admin-express

# --- API de l'Observatoire des ABC (badges « ABC » des fiches communes) ---
# Interrogée une seule fois par an lors du rafraîchissement des référentiels,
# en respectant une limitation de débit. Vide/désactivé : has_abc = false.
ABC_API_ENABLED=true
ABC_API_BASE=https://observatoire-abc.fr/api/v1

# --- geo.api.gouv.fr (codes postaux des communes) ---
GEO_API_BASE=https://geo.api.gouv.fr

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# --- Reverse proxy & cookies (production Plesk : TLS frontal) ---
# TRUSTED_PROXIES : IPs/CIDRs du frontal, séparés par des virgules, ou « * »
# quand l'IP du frontal n'est pas publiée (mutualisé : compromis assumé).
# Sans confiance accordée, le schéma vu par PHP reste http:// et le sitemap
# et les canonicals sont générés en http://.
TRUSTED_PROXIES=
COOKIE_SECURE=0

VITE_APP_NAME="${APP_NAME}"
